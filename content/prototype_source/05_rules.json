  "attention_levels": [
    {
      "id": "urgent",
      "label": "Atenció immediata",
      "meaning": "Possible perill, lesió greu o represàlia imminent. Aplicar protocol vigent."
    },
    {
      "id": "priority",
      "label": "Valoració prioritària",
      "meaning": "Indicadors rellevants que requereixen revisió o derivació prompta."
    },
    {
      "id": "scheduled",
      "label": "Seguiment programable",
      "meaning": "Cal ampliar informació o fer seguiment sense indici actual d'urgència."
    },
    {
      "id": "preventive",
      "label": "Informació preventiva",
      "meaning": "No s'han identificat indicadors suficients, però es faciliten recursos i s'indiquen limitacions."
