# LUCERNA 65 - local/runtime configuration
# Copy to .env for local use. No key is required for deterministic demo mode.

APP_ENV=development
DATA_MODE=ephemeral
REPORT_LOCALE=ca
ALLOWED_ORIGINS=*
MAX_FREE_TEXT_CHARS=6000
LUCERNA_LOAD_PER_CHAOS_ENV=1
# Optional explicit bridge to the source project's local env file:
# PER_CHAOS_ENV_PATH=G:\projectes IA\per-chaos-ad-ordinem\.env

# Optional LLM connector. Supported providers:
# openai | groq | openrouter | together | deepseek | mistral | ollama | anthropic | gemini
# LLM_PROVIDER=gemini
# LLM_MODEL=
# LLM_API_KEY=
# LLM_BASE_URL=

# Autodetection also works if you set one or more of these:
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Local model example:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
